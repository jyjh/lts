classDiagram
    class EMRAXMatFile {
        <<data file>>
        FDR
        Speed
        Torque
        Tractive_force
        Gearing_Map
    }

    class TireTIRFile {
        <<data file>>
        Pacejka coefficients
        nominal load
        nominal pressure
    }

    class lts.components.Powertrain.EMRAX228Powertrain {
        +load(matFilePath)
        +computeDriveForce(speed, throttle)
        +getMaxTorque(engineSpeed)
    }

    class lts.components.Powertrain.PowertrainState {
        +motorRPM
        +motorTorque
        +wheelTorque
        +rpmLimitActive
    }

    class lts.components.Tire.TireConstants {
        +params
        +nomLoad
        +nomPressure
        +refVelocity
    }

    class lts.components.Tire.PacejkaTire {
        +updateCorner(cornerState, normalLoad, slipAngle, slipRatio, camberAngle, mu)
        +updateAllFromState(state, vehicleManager, cornerLoads, mu)
    }

    class lts.components.TestTrack {
        +buildStraight()
        +buildOval()
        +buildSkidpad()
        +buildAutocross()
        +buildBusstop()
        +buildSlalom()
    }

    class TrackDataLoader {
        <<planned>>
        +parseGPSCSV(filepath)
        +smoothCurvature()
        +generateRacingLine()
    }

    class lts.telemetry.TelemetryExporter {
        +writeToMoTeCFormat(stateLog, filepath)
        +exportToMoTeCLog(stateLog, filepath)
        +convertCsvToMoTeCLog(filepath)
    }

    class MotecLogGenerator {
        <<submodule>>
        +motec_log_generator.py
    }

    EMRAXMatFile --> lts.components.Powertrain.EMRAX228Powertrain : loaded by constructor
    lts.components.Powertrain.EMRAX228Powertrain *-- lts.components.Powertrain.PowertrainState : state
    TireTIRFile --> lts.components.Tire.TireConstants : parsed by constructor
    lts.components.Tire.TireConstants --> lts.components.Tire.PacejkaTire : used by
    TrackDataLoader --> lts.components.TestTrack : future external track input
    lts.telemetry.TelemetryExporter <-- lts.simulation.Simulator : stateLog export
    lts.telemetry.TelemetryExporter --> MotecLogGenerator : CSV to LD conversion
