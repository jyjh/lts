classDiagram
    direction TB

    class lts.simulation.Simulator {
        +vehicleManager
        +driverModel
        +dt
        +step(state, input, ref)
        +simulate(initialState, track)
        +simulateReplay(initialState, profile)
    }

    class lts.simulation.BrakeForcePolicy {
        +compute(vehicle, cornerLoads, brakeInput, mode)$
        +validateMode(mode)$
    }

    class lts.simulation.DrivelineSupport {
        +getWheelInertia(vehicle)$
        +solveDifferential(vehicle, wheelOmega, totalTorque)$
        +initializeWheelSpeeds(vehicle, state)$
    }

    class lts.simulation.TelemetryWindow {
        +applyLapWindow(log, track)$
        +computeTrimDiagnostics(log)$
    }

    class lts.simulation.TrackReference {
        +precomputeSegments(track)$
        +repeatClosedTrack(track, warmupLaps, recordedLaps)$
        +getWarmupLaps(track)$
        +getRecordedLaps(track)$
    }

    class lts.vehicle.VehicleManager {
        +aero
        +suspension
        +powertrain
        +tire
        +track
        +totalMass
        +wheelbase
        +trackWidth
        +cgHeight
        +staticFrontWeight
        +maxSpeed
    }

    class lts.driver.DriverModel {
        +vehicleManager
        +lookaheadTime
        +brakingLookahead
        +computeInputs(state)
    }

    class lts.simulation.VehicleState {
        +vehicleManager
        +s
        +speed
        +ax
        +ay
        +heading
        +yawRate
        +pitchAngle
        +throttle
        +brake
        +time
        +updateFromDynamics(ax, ay, ds, dt, curvature, heading, mu)
        +toLogStruct()
    }

    class lts.components.Aero.AeroComponent {
        <<abstract>>
        +name
        +xPosition
        +zPosition
        +ClA
        +CdA
        +pitchSensitivityClA
        +computeDownforce(vehicleState)*
        +computeDrag(vehicleState)*
        +computeEffectiveHeight(vehicleState)
    }

    class lts.components.Aero.AeroManager {
        +components
        +addComponent(aeroComp)
        +computeForces(vehicleState)
    }

    class lts.components.Aero.WholeCarAero {
        +computeDownforce(vehicleState)
        +computeDrag(vehicleState)
    }

    class lts.components.Aero.FrontWing {
        +heightSensitivity
        +computeDownforce(vehicleState)
        +computeDrag(vehicleState)
    }

    class lts.components.Aero.RearWing {
        +heightSensitivity
        +computeDownforce(vehicleState)
        +computeDrag(vehicleState)
    }

    class lts.components.Aero.UnderbodyFloor {
        +stallHeight
        +heightExponent
        +computeDownforce(vehicleState)
        +computeDrag(vehicleState)
    }

    class lts.components.Suspension.SuspensionComponent {
        <<abstract>>
        +computeCornerLoads(state, FzFront, FzRear, totalMass, dt)*
    }

    class lts.components.Suspension.SuspensionManager {
        +frontLeft
        +frontRight
        +rearLeft
        +rearRight
        +staticFrontWeight
        +warmup(totalMass, dt)
        +computeCornerLoads(state, FzFront, FzRear, totalMass, dt)
        +computePitchAngle()
    }

    class lts.components.Suspension.SimpleSuspension {
        +springRate
        +dampingCoeff
        +reboundCoeff
        +motionRatio
        +bumpStopLength
        +tireSpringRate
        +unsprungMass
        +state
        +updateCorner(cornerState, demandedLoad, dt)
    }

    class lts.components.Suspension.SuspensionState {
        +damperPosition
        +damperVelocity
        +tireDeflection
        +tireNormalForce
        +demandedLoad
        +reset()
    }

    class lts.components.Powertrain.PowertrainComponent {
        <<abstract>>
        +getMaxTorque(engineSpeed)*
        +getTotalGearRatio()*
        +getDrivetrainEfficiency()*
    }

    class lts.components.Powertrain.EMRAX228Powertrain {
        +state
        +motorRPMCurve
        +tractiveForceCurveN
        +rpmFalloffStartRPM
        +rpmFalloffFactor
        +rpmLimitRPM
        +updateStateFromDrivenWheels(omega)
        +limitDrivenWheelAngularVelocity(omega)
    }

    class lts.components.Powertrain.PowertrainState {
        +drivenWheelAngularVelocity
        +drivenWheelRPM
        +motorAngularVelocity
        +motorRPM
        +motorTorque
        +wheelTorque
        +driveForce
        +rpmLimitActive
        +updateFromDrivenWheels(omega, gearRatio)
        +updateOutputs(throttle, motorTorque, wheelTorque, driveForce, efficiency, rpmLimitActive)
        +reset()
    }

    class lts.components.Tire.TireModel {
        <<abstract>>
        +computeLateralForce(normalLoad, slipAngle, mu)*
        +computeLongitudinalForce(normalLoad, slipRatio, mu)*
        +getPeakFriction(normalLoad)*
    }

    class lts.components.Tire.PacejkaTire {
        +tireConstants
        +FL
        +FR
        +RL
        +RR
        +computeSlipRatio(cornerState, vehicleSpeed)
        +updateWheelDynamics(cornerState, driveTorque, brakeTorque, dt)
        +updateAllFromState(state, vehicleManager, cornerLoads, mu)
    }

    class lts.components.Tire.TireState {
        +normalForce
        +slipAngle
        +slipRatio
        +angularVelocity
        +wheelRadius
        +Fx
        +Fy
        +reset()
    }

    class lts.components.Tire.TireConstants {
        +params
        +nomLoad
        +nomPressure
        +refVelocity
    }

    class lts.components.Track {
        <<abstract>>
        +getTrackPoints()*
        +getCurvature()*
        +getSurfaceFriction()*
        +getTotalLength()*
        +getHeading()*
        +getTrackWidth()*
        +resampleTrack(points, ds, closed)$
        +computeCurvature(points, closed)$
        +computeHeading(points, closed)$
        +cumulativeArcLength(points, closed)$
        +pathLength(points, closed)$
        +cleanPoints(points, closed)$
    }

    class lts.components.WaypointTrack {
        +Points
        +Width
        +Mu
        +Closed
        +Name
        +getTrackPoints()
        +getCurvature()
        +getSurfaceFriction()
        +getTotalLength()
        +getHeading()
        +getTrackWidth()
        +toStruct()
        +saveMat(fileName)
        +loadMat(fileName)$
        +fromCsv(fileName)$
    }

    class lts.components.TestTrack {
        +warmupLaps
        +recordedLaps
        +isClosedLoop()
        +getWarmupLaps()
        +getRecordedLaps()
    }

    class lts.telemetry.GraphPlotter {
        +plotAll(stateLog, lapTime, track, vehicle, aero)$
        +plotAero(stateLog, vehicle, aero)$
        +plotSuspension(stateLog, vehicle)$
        +plotTire(stateLog, vehicle)$
        +plotPowertrain(stateLog, vehicle)$
    }

    lts.components.Aero.AeroComponent <|-- lts.components.Aero.AeroManager
    lts.components.Aero.AeroComponent <|-- lts.components.Aero.WholeCarAero
    lts.components.Aero.AeroComponent <|-- lts.components.Aero.FrontWing
    lts.components.Aero.AeroComponent <|-- lts.components.Aero.RearWing
    lts.components.Aero.AeroComponent <|-- lts.components.Aero.UnderbodyFloor
    lts.components.Suspension.SuspensionComponent <|-- lts.components.Suspension.SuspensionManager
    lts.components.Powertrain.PowertrainComponent <|-- lts.components.Powertrain.EMRAX228Powertrain
    lts.components.Tire.TireModel <|-- lts.components.Tire.PacejkaTire
    lts.components.Track <|-- lts.components.WaypointTrack
    lts.components.WaypointTrack <|-- lts.components.TestTrack

    lts.simulation.Simulator *-- lts.vehicle.VehicleManager : vehicleManager
    lts.simulation.Simulator *-- lts.driver.DriverModel : driverModel
    lts.simulation.Simulator ..> lts.simulation.BrakeForcePolicy : brake policy
    lts.simulation.Simulator ..> lts.simulation.DrivelineSupport : driveline helpers
    lts.simulation.Simulator ..> lts.simulation.TelemetryWindow : lap windows
    lts.simulation.Simulator ..> lts.simulation.TrackReference : track helpers
    lts.vehicle.VehicleManager *-- lts.components.Aero.AeroComponent : aero
    lts.vehicle.VehicleManager *-- lts.components.Suspension.SuspensionManager : suspension
    lts.vehicle.VehicleManager *-- lts.components.Powertrain.PowertrainComponent : powertrain
    lts.vehicle.VehicleManager *-- lts.components.Tire.TireModel : tire
    lts.vehicle.VehicleManager *-- lts.components.Track : track
    lts.simulation.VehicleState --> lts.vehicle.VehicleManager : vehicleManager

    lts.components.Aero.AeroManager o-- lts.components.Aero.AeroComponent : components
    lts.components.Suspension.SuspensionManager *-- lts.components.Suspension.SimpleSuspension : corners
    lts.components.Suspension.SimpleSuspension *-- lts.components.Suspension.SuspensionState : state
    lts.components.Powertrain.EMRAX228Powertrain *-- lts.components.Powertrain.PowertrainState : state
    lts.components.Tire.PacejkaTire *-- lts.components.Tire.TireState : corners
    lts.components.Tire.PacejkaTire *-- lts.components.Tire.TireConstants : tireConstants
